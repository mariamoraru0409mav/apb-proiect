    "/report": {
      "post": {
        "tags": [
          "common"
        ],
        "summary": "Post Report",
        "description": "The solution's standardized results; the latest accepted one is `state[\"report\"]`.",
        "operationId": "post_report_report_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "items": {
                    "items": {
                      "$ref": "#/components/schemas/Report_ReportItem"
                    },
                    "type": "array",
                    "title": "Items"
                  },
                  "idempotency_key": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
